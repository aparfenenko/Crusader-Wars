<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CrusaderWars.Avalonia.Views.PathSetupWindow"
        Title="Crusader Conflicts — Path Setup" Width="880" Height="520">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
            <Button Content="Detect &amp; Save" Click="OnDetectSave" />
            <TextBlock x:Name="Hint" VerticalAlignment="Center"
                       Text="Missing pieces can be copied from a Windows Crusader Conflicts installation." />
        </StackPanel>
        <ScrollViewer>
            <StackPanel x:Name="RowsPanel" Spacing="2" />
        </ScrollViewer>
    </DockPanel>
</Window>
