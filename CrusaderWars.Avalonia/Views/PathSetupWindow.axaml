<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CrusaderWars.Avalonia.Views.PathSetupWindow"
        Title="Crusader Conflicts — Path Setup" Width="960" Height="620">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
            <Button Content="Save paths" Click="OnSave" />
            <Button Content="Auto-fill missing" Click="OnAutoFill" />
            <TextBlock x:Name="Hint" VerticalAlignment="Center"
                       Text="Set paths manually (GOG, custom installs) or auto-fill from Steam detection." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="2">
            <TextBlock Text="Detection status (after save):" />
            <ScrollViewer Height="120">
                <StackPanel x:Name="StatusPanel" Spacing="2" />
            </ScrollViewer>
        </StackPanel>
        <ScrollViewer>
            <StackPanel x:Name="RowsPanel" Spacing="6" />
        </ScrollViewer>
    </DockPanel>
</Window>
